# Database Connection
DATABASE_URL="postgresql://proofledger_user:proofledger_pass@localhost:5433/proofledger_db?schema=public"

# API Server & Security
API_PORT=3000
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3001,http://localhost:3000"

# JWT Authentication
JWT_SECRET="proofledger_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="1d"

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# OpenAPI / Swagger Documentation
ENABLE_SWAGGER=true
SWAGGER_PATH=docs

# Private MinIO / S3 Object Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9090
MINIO_ACCESS_KEY="proofledger_minio"
MINIO_SECRET_KEY="proofledger_minio_pass"
MINIO_BUCKET="proofledger-evidence"
MINIO_USE_SSL=false
MAX_FILE_SIZE=52428800

# Legacy Storage Aliases
STORAGE_ENDPOINT="localhost"
STORAGE_PORT=9090
STORAGE_ACCESS_KEY="proofledger_minio"
STORAGE_SECRET_KEY="proofledger_minio_pass"
STORAGE_BUCKET="proofledger-evidence"
STORAGE_USE_SSL=false
MAX_FILE_SIZE_BYTES=52428800
